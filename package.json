{
  "name": "opencode-qoder-auth",
  "version": "2.0.1",
  "description": "OpenCode v2 plugin for Qoder CN: PAT authentication, model discovery, COSY-signed streaming",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "scripts": {
    "compile": "tsc && node build.tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test test/*.test.mjs",
    "prepublishOnly": "npm run compile"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": "^0.6.8",
    "@opentui/solid": "^0.6.8",
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.12",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "qoder",
    "qoder-cn",
    "pat",
    "authentication"
  ],
  "files": [
    "dist"
  ]
}
